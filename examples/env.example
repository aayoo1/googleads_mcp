# Copy this file to .env (which .gitignore keeps out of git) and fill it in.
# Never commit the filled in version.

GOOGLE_PROJECT_ID=<project-id>
GOOGLE_ADS_DEVELOPER_TOKEN=<your-developer-token>
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=<desktop-client-id>
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=<desktop-client-secret>

# Manager account ID, digits only, no dashes. See docs/05.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=<manager-customer-id>
